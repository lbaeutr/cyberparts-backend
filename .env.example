# Copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql+psycopg://cyberparts:cyberparts@127.0.0.1:5432/cyberparts

SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cyberparts.dev
ADMIN_PASSWORD=Admin123!

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: http://localhost:8000/api/auth/oauth/github/callback
# El host de la callback debe coincidir con el del navegador (cookie oauth_state por host).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback
FRONTEND_URL=http://localhost:5173
